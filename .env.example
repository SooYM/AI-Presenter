APP_ENV=production
APP_URL=https://your-domain.example
# Random server-only secret, at least 32 characters. Local setup generates it.
APP_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=docchat
DB_USER=docchat
DB_PASSWORD=
# Required for remote MySQL. Absolute path to provider CA certificate.
DB_SSL_CA=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Keep outside the public web root. Blank uses <project>/storage.
STORAGE_PATH=
RAG_SCORE_THRESHOLD=0.35
# Absolute directory containing pdfinfo and pdftoppm. pdftotext is optional.
POPPLER_BIN=
# Optional offline PDF text helper; this interpreter needs pypdf installed.
PYTHON_BIN=
# Local Windows only. Requires licensed PowerPoint and no open PowerPoint windows.
POWERPOINT_CONVERSION=false
